# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB Atlas connection string (database name is set in code: asadiqbalprofile)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Secret used to sign admin session tokens. Use at least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public site URL, used for canonical links, the sitemap and structured data.
# Set this when you move to a custom domain.
NEXT_PUBLIC_SITE_URL=https://asadiqbal.vercel.app

# Only used by scripts/create-admin.mjs (not read by the app at runtime)
ADMIN_EMAIL=
ADMIN_PASSWORD=
